{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["src/renderer/*"],
      "@static/*": ["../../static/*"]
    },
    "noEmit": true
  },
  "include": ["src/renderer/**/*", "src/shared/**/*"],
  "references": [{ "path": "../shared" }]
}
